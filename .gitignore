# macOS
.DS_Store

# Author/agent working notes, checklists, and application drafts — never publish
.private/
/AGENTS.md

# Microsoft Office temp/lock files (e.g. ~$OSHWA-APPLICATION-DRAFT.docx while a .docx is open)
~$*

# Altium Designer — cache, logs, and generated outputs (regenerable from source, don't track)
# Based on github/gitignore community/AltiumDesigner.gitignore
History
__Previews
Project\ Logs*
Project\ Outputs*
debug.log
Status\ Report.txt
*.PcbDoc.htm
*.SchDocPreview
*.PcbDocPreview
.~lock.*

# KiCad — local history (a nested git repo), lock files, backups, caches
.history/
*.lck
*-backups/
_autosave-*
fp-info-cache

# Altium backup/lock files
*.~*
*.Bak
*.ldb

# Local design review evidence
/.local-verification/

# PCB review diagnostics and editor session preferences stay local
/RheoBoard_PCB/**/Verification/
/RheoBoard_PCB/**/*.kicad_prl
/RheoBoard_PCB/**/IMPORT_REPORT.txt
/RheoBoard_PCB/**/Missing_Illustrations.txt
